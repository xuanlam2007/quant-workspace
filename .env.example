# Địa chỉ ví dụ kích hoạt dữ liệu mẫu, không kết nối mạng bên ngoài.
MARKET_DATA_API_URL=https://api.example.com
MARKET_DATA_SOCKET_URL=https://socket.example.com/
MARKET_DATA_PROVIDER_NAME=Market data

# Chỉ bật khi provider yêu cầu Bearer token; feed hiện tại không cần.
# MARKET_DATA_API_TOKEN=your-provider-token
# Engines run on loopback. A private token is generated locally when unset.
AUDITOR_ENGINE_URL=http://127.0.0.1:8765
BACKTEST_ENGINE_URL=http://127.0.0.1:8766
